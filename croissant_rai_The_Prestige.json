    "@type": "Person",
    "name": "Steve Wen",
    "url": "https://huggingface.co/SediRockStar"
  },
  "keywords": [
    "video-text-to-text",
    "visual-question-answering",
    "English",
    "cc-by-nc-sa-4.0",
    "1K<n<10K",
    "arxiv:2610.38103",
    "🇺🇸 Region: US",
    "magic",
    "Vision Language Models",
    "Visual reasoning"
  ],
  "license": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  "url": "https://huggingface.co/datasets/SediRockStar/The_Prestige",
  "citeAs": "@article{wen2026prestige, title={The Prestige: Benchmarking Cognitive Visual Reasoning using Magic Tricks}, author={Wen, Shuo and Du, Beixi and Meriaux, Edwin and Shi, Junming and Si, Chloe and Meger, David and Precup, Doina and Dudek, Gregory}, journal={arXiv preprint arXiv:2610.38103}, year={2026}}",
  "datePublished": "2026-11-06",
  "version": "1.0.0",
  "rai:dataLimitations": "This dataset features professional on-stage magic videos and does not expand to street magic videos.",
  "rai:dataBiases": "The data specifically features Western-style magic performances. Very few magic performances from other cultures.",
  "rai:personalSensitiveInformation": "None of the personal or sensitive information is present.",
  "rai:dataUseCases": "The dataset evaluates the cognitive reasoning abilities of the Vision Language Models. The dataset is not intended to be used outside research purposes.",
  "rai:dataSocialImpact": "The dataset enables more rigorous evaluations of the cognitive reasoning abilities of the Vision Language Models.",
  "rai:hasSyntheticData": false,
